   "source": [
    "def add(*numbers):\n",
    "    total = 0\n",
    "    for n in numbers:\n",
    "        total += n\n",
    "    return total\n",
    "\n",
    "print(add(2, 3))              # 5\n",
    "print(add(2, 3, 4))           # 9\n",
    "print(add(10, 20, 30, 40))    # 100\n",
    "print(add())"
   ]
  }
